# Backend FastAPI: pila completa de TTS (torch, transformers, kokoro, etc.)
#
# Perfil de motores vía build-arg (chatterbox-tts y qwen-tts fijan versiones
# de transformers incompatibles entre sí, no pueden convivir en una imagen):
#   docker build --build-arg TTS_PROFILE=classic -f docker/Dockerfile.backend .  (defecto: kokoro+chatterbox)
#   docker build --build-arg TTS_PROFILE=qwen    -f docker/Dockerfile.backend .  (qwen3-*)
#   docker build --build-arg TTS_PROFILE=kokoro -f docker/Dockerfile.backend .  (solo kokoro)
#   docker build --build-arg TTS_PROFILE=kokoro+qwen -f docker/Dockerfile.backend .  (kokoro+qwen3)
FROM python:3.11-slim

ARG TTS_PROFILE=classic
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Mirror opcional para descargas apt más rápidas
RUN sed -i 's|http://deb.debian.org|http://ftp.br.debian.org|g' /etc/apt/sources.list.d/debian.sources || \
    sed -i 's|http://deb.debian.org|http://ftp.br.debian.org|g' /etc/apt/sources.list

# Dependencias del sistema: ffmpeg para pydub, espeak-ng para Kokoro (en/es),
# sox para el paquete qwen-tts (motores qwen3-*).
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg espeak-ng sox libsox-fmt-all && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip

# Copiar primero el manifest para aprovechar el caching de capas
COPY pyproject.toml /app/
# 1) Dependencias base (capa cacheable, sin paquetes ML de motor)
RUN python3 -m pip install --no-cache-dir \
    "transformers>=4.46.0" \
    "accelerate>=0.30.0" \
    "huggingface_hub>=0.24.0" \
    "torch>=2.1.0" \
    "torchaudio>=2.1.0" \
    "pydub>=0.25.1" \
    "soundfile>=0.12.1" \
    "numpy>=1.25.0" \
    "tqdm>=4.66.1" \
    "flask>=3.0" \
    "fastapi>=0.110" \
    "uvicorn>=0.29" \
    "python-multipart>=0.0.9" \
    "requests>=2.31"

# Código fuente
COPY README.md /app/
COPY src /app/src

# 2) Paquete editable + paquete de motores del perfil elegido.
#    (chatterbox-tts fija transformers==4.46.3 y qwen-tts fija ==4.57.3: en
#    comandos separados pip ajusta la versión sin conflictos). Instalar los
#    paquetes ML DESPUÉS de `-e .` evita que pip degradarlos al resolver los
#    rangos anchos del pyproject.
RUN python3 -m pip install --no-cache-dir -e . && \
    case "$TTS_PROFILE" in \
      qwen)        python3 -m pip install --no-cache-dir "qwen-tts>=0.1.1" "onnxruntime<1.24";; \
      kokoro)      python3 -m pip install --no-cache-dir "kokoro>=0.9.2";; \
      kokoro+qwen) python3 -m pip install --no-cache-dir "kokoro>=0.9.2" "qwen-tts>=0.1.1" "onnxruntime<1.24";; \
      *)           python3 -m pip install --no-cache-dir "kokoro>=0.9.2" "chatterbox-tts>=0.1.6";; \
    esac

# Audio generado por la API (montar como volumen para persistirlo)
ENV MD_TTS_JOBS_DIR=/app/output_audio/web

EXPOSE 8000

CMD ["uvicorn", "md_tts.api.app:app", "--host", "0.0.0.0", "--port", "8000"]